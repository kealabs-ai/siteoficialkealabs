{
  "name": "kealabs-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.14.1",
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:all": "concurrently \"npm run start:site\" \"npm run start:owner\" \"npm run start:proxy\"",
    "start:site": "react-scripts start",
    "start:owner": "cd owner && npm start",
    "start:proxy": "node server.js",
    "build": "react-scripts build",
    "build:owner": "cd owner && npm run build",
    "build:all": "npm run build && npm run build:owner",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "npm run install:owner",
    "install:owner": "cd owner && npm install",
    "production": "npm run build:all && npm run start:production",
    "start:production": "node server.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
